# ───────────────────────────────────────────────────────────────
# PILOT — Variables d'environnement
# Copier ce fichier en « .env.local » et remplir les valeurs.
# NE JAMAIS versionner .env.local (clés secrètes).
# ───────────────────────────────────────────────────────────────

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique
# Clé service_role : UNIQUEMENT côté serveur (webhooks, jamais exposée au client)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# URL publique de l'app (pour les liens de paiement et webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FedaPay (Étape 7) — sandbox d'abord
FEDAPAY_SECRET_KEY=sk_sandbox_xxx
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxx
# « sandbox » ou « live »
FEDAPAY_ENV=sandbox
